[Desktop Entry]
Type=Application
Version=1.0
Name=Ejecutar script de shell
GenericName=Shell Script Runner
Comment=Ejecuta este script de shell en una ventana de terminal
Exec=@RUNSH@ %f
Icon=utilities-terminal
Terminal=false
NoDisplay=true
MimeType=application/x-shellscript;text/x-shellscript;
Keywords=shell;script;sh;bash;run;execute;terminal;
